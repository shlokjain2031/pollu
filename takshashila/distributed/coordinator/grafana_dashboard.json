{
  "dashboard": {
    "title": "Takshashila Coordinator Metrics",
    "panels": [
      {
        "title": "Request Rate",
        "targets": [
          {
            "expr": "rate(requests_total[1m])"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Request Timeout Rate",
        "targets": [
          {
            "expr": "rate(request_timeout_total[1m])"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Cache Hit Rate",
        "targets": [
          {
            "expr": "rate(cache_hits_total[5m]) / (rate(cache_hits_total[5m]) + rate(cache_misses_total[5m]))"
          }
        ],
        "type": "stat"
      },
      {
        "title": "Cache Entries",
        "targets": [
          {
            "expr": "cache_entries"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Cache Evictions by Reason",
        "targets": [
          {
            "expr": "rate(cache_evictions_total[5m])"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Cache Lookup Latency (P95)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(cache_lookup_latency_seconds_bucket[5m]))"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Dedup Leaders",
        "targets": [
          {
            "expr": "rate(dedup_leaders_total[1m])"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Dedup Followers",
        "targets": [
          {
            "expr": "rate(dedup_followers_total[1m])"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Dedup Effectiveness Rate",
        "targets": [
          {
            "expr": "rate(dedup_followers_total[5m]) / (rate(dedup_leaders_total[5m]) + rate(dedup_followers_total[5m]))"
          }
        ],
        "type": "stat"
      },
      {
        "title": "Dedup Active Entries",
        "targets": [
          {
            "expr": "dedup_active_entries"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Dedup Peak Followers Per Leader",
        "targets": [
          {
            "expr": "dedup_peak_followers_per_leader"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Dedup Wait Latency (P99)",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(dedup_wait_latency_seconds_bucket[5m]))"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Worker Compute Latency (P50, P95, P99)",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(worker_compute_latency_seconds_bucket[5m]))"
          },
          {
            "expr": "histogram_quantile(0.95, rate(worker_compute_latency_seconds_bucket[5m]))"
          },
          {
            "expr": "histogram_quantile(0.99, rate(worker_compute_latency_seconds_bucket[5m]))"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Worker Timeouts",
        "targets": [
          {
            "expr": "rate(worker_timeout_total[1m])"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Errors by Type",
        "targets": [
          {
            "expr": "rate(errors_total[5m])"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Queue Timeouts",
        "targets": [
          {
            "expr": "rate(queue_timeout_total[1m])"
          }
        ],
        "type": "graph"
      }
    ]
  }
}
